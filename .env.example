APP_NAME="Handayani Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://handayani-analytics.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# 
APP_MAINTENANCE_STORE=database

# 
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=handayani_analytics
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# 
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# Handayani Analytics — SerpApi (Google Maps Reviews)
# =====================================================================
# API key dari https://serpapi.com/manage-api-key (JANGAN commit nilai asli).
SERPAPI_KEY=

# Timeout & retry panggilan HTTP ke SerpApi (detik).
SERPAPI_TIMEOUT=20
SERPAPI_RETRY=2
SERPAPI_RETRY_DELAY=500

# Batas pengaman kuota: maksimum "search" SerpApi per hari (guard biaya).
# Free plan SerpApi = 250 search/bulan -> ~8/hari aman.
SERPAPI_DAILY_SEARCH_LIMIT=40

# =====================================================================
# Analytics
# =====================================================================
# Zona waktu untuk agregasi minggu/bulan (default: Asia/Jakarta).
ANALYTICS_TIMEZONE=Asia/Jakarta

# Tanggal snapshot otomatis dijalankan (jam lokal ANALYTICS_TIMEZONE).
ANALYTICS_SNAPSHOT_HOUR=2
ANALYTICS_WEEK_STARTS_ON=1
ANALYTICS_STORE_REVIEWS=false
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_ENGINE=google_maps_reviews
SERPAPI_HL=id
SERPAPI_GL=id
SERPAPI_MAX_PAGES_PER_PLACE=3
APP_TIMEZONE=Asia/Jakarta
SERPAPI_DATA_ID_RM_HANDAYANI=0x2dd7036fcefb89b5:0xbaf316dbc59eefd5
SERPAPI_DATA_ID_COTTAGE_PAITON=0x2dd7036fe2eb31d9:0x856417a7becac944
MAPS_URL_RM_HANDAYANI=https://maps.app.goo.gl/8HeX848jxD6rHFFG9
MAPS_URL_COTTAGE_PAITON=https://maps.app.goo.gl/khrSGPHrRpJrzUhC6

SERPAPI_REVIEWS_ENABLED=true
SERPAPI_REVIEWS_MAX_PAGES=3